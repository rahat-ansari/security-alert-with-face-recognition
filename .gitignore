# =============================================================================
# SECURITY ALERT WITH FACE RECOGNITION - Professional .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENVIRONMENT & SECRETS
# -----------------------------------------------------------------------------
# Never commit secrets, credentials, or environment variables
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
serviceAccountKey.json
*.log

# -----------------------------------------------------------------------------
# 2. PYTHON - Core
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff
*.log
local_settings.py

# Flask stuff
instance/
.webassets-cache

# Scrapy stuff
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.venv
venv/
ENV/
env/
.conda/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# -----------------------------------------------------------------------------
# 3. YOLO & MACHINE LEARNING
# -----------------------------------------------------------------------------
# YOLO training runs and outputs
runs/
examples/runs/

# Model weights - ALL major formats
*.pt
*.pth
*.weights
*.onnx
*.tflite
*.h5
*.pkl
*.torchscript

# Dataset cache
datasets/
*.cache
*.cache.pt

# Training artifacts
wandb/
tensorboard/
mlruns/

# -----------------------------------------------------------------------------
# 4. REACT / FRONTEND (client/)
# -----------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/

# Testing
coverage/

# Production
build/
dist/
.next/
.nuxt/
.output/

# Misc
.DS_Store
*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env files
.env*.local

# TypeScript
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# 5. MEDIA FILES & BIOMETRIC DATA
# -----------------------------------------------------------------------------
# Large media files (videos, images)
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv
*.webm
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.svg
*.ico
*.webp
*.tiff
*.tif

# Audio files
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.m4a
*.wma

# Video archives and compressed media
*.zip
*.tar
*.gz
*.bz2
*.7z
*.rar

# Windows shortcuts
*.lnk

# Family members / Face recognition datasets (CRITICAL - biometric data)
family_members/
face_dataset/
faces/
person_images/

# Security camera outputs
security_output.avi
*output*.avi
*output*.mp4

# -----------------------------------------------------------------------------
# 6. DOCKER
# -----------------------------------------------------------------------------
# Docker
.docker/
docker-compose.override.yml

# -----------------------------------------------------------------------------
# 7. AZURE / CLOUD / INFRASTRUCTURE
# -----------------------------------------------------------------------------
# Azure
.azure/
.azure/*.json
*.publishsettings

# AWS
.aws/
.ebextensions/

# GCP
.gcp/

# Terraform state
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.*

# -----------------------------------------------------------------------------
# 8. IDE & EDITORS
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# VS
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains
.idea/
*.iml
*.iws
out/

# Emacs
*~
\#*\#
.\#*

# Vim
*.swp
*.swo
*~

# Sublime Text
*.tmlanguage.cache
*.Preferences.sublime-workspace

# -----------------------------------------------------------------------------
# 9. OPERATING SYSTEM
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Scripts

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# 10. DOCUMENTATION & EXAMPLES
# -----------------------------------------------------------------------------
# Documentation build outputs
docs/_build/
site/
build/html/

# Example outputs
examples/*.avi
examples/*.jpg

# -----------------------------------------------------------------------------
# 11. LOGS & TEMP
# -----------------------------------------------------------------------------
# Application logs (generated at runtime)
security_logs/

# -----------------------------------------------------------------------------
# 12. MISCELLANEOUS
# -----------------------------------------------------------------------------
# Temporary files
*.tmp
*.temp
*.bak
*.backup
*~

# PDF exports
*.pdf

# Compile flags
*.cmake
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/
build/

# Jupyter nbextension
jupyter_nbextension/_build/
/.kilo
/.kilocode
